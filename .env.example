# Copia este archivo como ".env" y ajusta los valores para tu fiscalía.

# Clave secreta de la instalación. Genera una propia con:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SIMASC_SECRET_KEY=

# 1 solo en la computadora de quien desarrolla. En el servidor de la fiscalía: 0.
SIMASC_DEBUG=0

# Nombre que aparece en el encabezado.
SIMASC_INSTITUCION=Fiscalía General del Estado

# Nombres o direcciones con las que se entra al sistema, separados por coma.
SIMASC_HOSTS=localhost,127.0.0.1

# Base de datos. Sin esta línea se usa un archivo SQLite en datos/simasc.sqlite3.
# SIMASC_DATABASE_URL=postgres://usuario:clave@servidor:5432/simasc

# 1 cuando el sistema se sirve por HTTPS (recomendado en producción).
SIMASC_HTTPS=0
# SIMASC_ORIGENES_CSRF=https://simasc.mifiscalia.gob.mx

# Minutos sin actividad antes de cerrar la sesión.
SIMASC_MINUTOS_SESION=30
